{
  "name": "axiom-cli",
  "version": "0.1.0",
  "description": "Axiom is a production-grade agentic coding assistant that lives in your terminal.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "axiom": "./bin/axiom.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "scripts": {
